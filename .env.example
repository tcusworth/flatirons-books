# --- Required ---
# Postgres connection string (Neon, Supabase, Railway, etc.)
DATABASE_URL=postgres://user:pass@host:5432/dbname
# Set to false when using a transaction-mode pooler (e.g. Supabase port 6543)
DB_PREPARE=true

# Single-user login
APP_PASSWORD=choose-a-long-password
# 32+ random characters:  openssl rand -base64 48
SESSION_SECRET=
# Exactly 32 random bytes, base64 (encrypts Plaid access tokens):  openssl rand -base64 32
ENCRYPTION_KEY=

# Your deployed URL, no trailing slash (used for the Plaid webhook)
# Only needed for a custom domain; on Netlify the site URL is picked up automatically
APP_URL=
APP_TIME_ZONE=America/Denver

# --- Bank feeds (Plaid) ---
PLAID_CLIENT_ID=
PLAID_SECRET=
# sandbox or production
PLAID_ENV=sandbox
# Random string; the webhook URL is built as APP_URL/api/plaid/webhook?key=<this>
PLAID_WEBHOOK_SECRET=
# How many days of history to ask for on a new connection
PLAID_DAYS_REQUESTED=730

# --- AI categorization and PDF statements (Anthropic) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
ANTHROPIC_PDF_MODEL=claude-sonnet-5-5

# --- Daily bank sync (Netlify Scheduled Function, backup to the webhook) ---
CRON_SECRET=

# --- AI connector (MCP) ---
# Sign-in for Claude and other connectors uses OAuth and your APP_PASSWORD; APP_URL must be your https address.
# Optional: a fixed key (32+ chars) for scripts or clients that send "Authorization: Bearer <key>" instead of OAuth.
MCP_API_KEY=
